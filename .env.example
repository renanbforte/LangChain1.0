# =============================================================================
# .env.example  (MODELO — pode ir para o GitHub, pois NÃO tem valores reais)
# -----------------------------------------------------------------------------
# COMO USAR:
#   1. Copie este arquivo para um novo chamado ".env"
#        (no PowerShell:  Copy-Item .env.example .env )
#   2. Preencha cada variável abaixo com os seus valores REAIS.
#   3. O arquivo ".env" (com os valores reais) É IGNORADO pelo .gitignore,
#      então ele NUNCA vai para o GitHub. É lá que ficam os segredos.
#
# Formato de cada linha:  NOME_DA_VARIAVEL=valor   (sem espaços ao redor do =)
# =============================================================================

# --- Chave da OpenAI (modelo gpt-3.5-turbo) ---------------------------------
# Pegue em: https://platform.openai.com/api-keys
OPENAI_API_KEY=coloque-sua-chave-openai-aqui

# --- Chave do Google Gemini (para quando você trocar de modelo depois) ------
# Pegue em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=coloque-sua-chave-google-aqui

# --- Chave da Tavily (ferramenta de busca na web) ---------------------------
# Pegue em: https://app.tavily.com/  (tem plano gratuito)
TAVILY_API_KEY=coloque-sua-chave-tavily-aqui

# --- URL de conexão com o banco PostgreSQL ----------------------------------
# Formato:  postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#   USUARIO  -> normalmente "postgres"
#   SENHA    -> a senha que você definiu na instalação do PostgreSQL
#   HOST     -> "localhost" (o banco está na sua própria máquina)
#   PORTA    -> "5432" (porta padrão do PostgreSQL)
#   BANCO    -> "agente_ia" (o banco que criamos na Parte 1 do README)
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/agente_ia

# --- Controle de memória (sumarização de conversas longas) ------------------
# Estas TRÊS variáveis controlam quando o agente resume o histórico para não
# estourar a janela de contexto do modelo. Todas são OPCIONAIS: se você apagar
# ou não preencher, o código usa valores padrão razoáveis.

# ESTRATEGIA_MEMORIA: como decidir a hora de resumir. Aceita:
#   "tokens"    -> resume por quantidade de tokens (PADRÃO e recomendado).
#   "mensagens" -> resume por número de mensagens trocadas.
# Troque SÓ esta linha para mudar de estratégia (não precisa mexer no código).
ESTRATEGIA_MEMORIA=tokens

# MAX_TOKENS_RESUMO: usado quando ESTRATEGIA_MEMORIA=tokens.
# Resume quando o histórico passar deste número de tokens.
MAX_TOKENS_RESUMO=3000

# MAX_MENSAGENS_RESUMO: usado quando ESTRATEGIA_MEMORIA=mensagens.
# Resume quando o histórico passar deste número de mensagens.
MAX_MENSAGENS_RESUMO=40

# --- LangSmith (observabilidade / "raio-x" do agente) -----------------------
# OPCIONAL, mas MUITO útil para aprender: com estas variáveis, o LangChain
# envia automaticamente cada passo do agente (prompts, tools, tokens, tempo)
# para o painel web do LangSmith. Você NÃO muda nenhuma linha de código —
# basta preencher aqui. Pegue a chave em: https://smith.langchain.com/ (settings).

# Liga o rastreamento. Sem esta linha (ou com "false"), nada é enviado.
LANGSMITH_TRACING=true

# Sua chave do LangSmith (fica só no .env, nunca no código).
LANGSMITH_API_KEY=coloque-sua-chave-langsmith-aqui

# Nome do projeto no painel do LangSmith (agrupa os traces). Escolha o que quiser.
LANGSMITH_PROJECT=langchain1-estudo
