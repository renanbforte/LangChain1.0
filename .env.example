# =============================================================================
# .env.example  (MODELO — pode ir para o GitHub, pois NÃO tem valores reais)
# -----------------------------------------------------------------------------
# COMO USAR:
#   1. Copie este arquivo para um novo chamado ".env"
#        (no PowerShell:  Copy-Item .env.example .env )
#   2. Preencha cada variável abaixo com os seus valores REAIS.
#   3. O arquivo ".env" (com os valores reais) É IGNORADO pelo .gitignore,
#      então ele NUNCA vai para o GitHub. É lá que ficam os segredos.
#
# Formato de cada linha:  NOME_DA_VARIAVEL=valor   (sem espaços ao redor do =)
# =============================================================================

# --- Chave da OpenAI (modelo gpt-3.5-turbo) ---------------------------------
# Pegue em: https://platform.openai.com/api-keys
OPENAI_API_KEY=coloque-sua-chave-openai-aqui

# --- Chave do Google Gemini (para quando você trocar de modelo depois) ------
# Pegue em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=coloque-sua-chave-google-aqui

# --- Chave da Tavily (ferramenta de busca na web) ---------------------------
# Pegue em: https://app.tavily.com/  (tem plano gratuito)
TAVILY_API_KEY=coloque-sua-chave-tavily-aqui

# --- URL de conexão com o banco PostgreSQL ----------------------------------
# Formato:  postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#   USUARIO  -> normalmente "postgres"
#   SENHA    -> a senha que você definiu na instalação do PostgreSQL
#   HOST     -> "localhost" (o banco está na sua própria máquina)
#   PORTA    -> "5432" (porta padrão do PostgreSQL)
#   BANCO    -> "agente_ia" (o banco que criamos na Parte 1 do README)
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/agente_ia
